# Copy to docker/.env and change every password before the first start.

# Image built with: docker build -f docker/Containerfile -t tv-archive:1.0.0 .
ARCHIVE_IMAGE=tv-archive
ARCHIVE_TAG=1.0.0

# Site name = the host name users type in the browser (or the server IP's DNS name).
SITE_NAME=archive.ortas.local

# Administrator password for the site, and MariaDB root password.
ADMIN_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Port published on the server.
HTTP_PORT=8080

# Gunicorn: workers ≈ (2 × CPU cores) + 1
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
