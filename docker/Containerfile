# Production image: Frappe v16 + tv_archive, built from this repository.
#
# Based on frappe_docker images/layered/Containerfile, with one change: the app is
# copied from the build context instead of being cloned from a Git remote.
#
#   docker build -f docker/Containerfile -t tv-archive:1.0.0 .
#
# Run from the repository root (the build context is the app itself).

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_BRANCH} AS builder

ARG FRAPPE_BRANCH=version-16
ARG FRAPPE_PATH=https://github.com/frappe/frappe

USER frappe

RUN bench init \
    --frappe-branch=${FRAPPE_BRANCH} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

COPY --chown=frappe:frappe . apps/tv_archive

RUN if command -v uv >/dev/null 2>&1; then \
      uv pip install --python env/bin/python -e apps/tv_archive; \
    else \
      env/bin/pip install --no-cache-dir -e apps/tv_archive; \
    fi && \
    echo "tv_archive" >> sites/apps.txt && \
    bench build --app tv_archive && \
    echo "{}" > sites/common_site_config.json && \
    find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_BRANCH} AS backend

LABEL org.opencontainers.image.title="tv-archive" \
      org.opencontainers.image.description="نظام أرشفة المسلسلات والبرامج - الفضائية السورية"

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Keep built assets in the image layer; the entrypoint links them into the sites volume.
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
    rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
COPY docker/resources/main-entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/resources/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["start.sh"]
